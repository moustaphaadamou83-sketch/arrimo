# Connexion PostgreSQL
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/arrimo
# Port du serveur
PORT=3010
# Clé partagée avec SH pour activer le module par établissement (longue et aléatoire)
SH_API_KEY=
# Durée d'une session de connexion, en heures
SESSION_HEURES=12
# Fréquence de la détection des blocages, en minutes
BLOCAGES_MINUTES=15
# Mot de passe des comptes de démonstration (db:seed seulement)
DEMO_MOT_DE_PASSE=Demo-Arrimo-2026
NODE_ENV=development
# Copilote, mode IA facultatif (laisser vide pour le mode local seulement)
COPILOTE_IA_CLE=
COPILOTE_IA_MODELE=claude-sonnet-5-5
# Serveur de démonstration : bandeau « Démonstration · données fictives » et remise à zéro depuis l'administration
ARRIMO_DEMO=0
# Pages légales (/confidentialite, /conditions) : champs à remplir ; laissés vides, ils s'affichent « [à remplir] »
ARRIMO_LEGAL_ENTITE=
ARRIMO_LEGAL_ADRESSE=
ARRIMO_LEGAL_RESPONSABLE=
ARRIMO_LEGAL_CONTACT=
ARRIMO_LEGAL_DUREE_COMPTES=
ARRIMO_LEGAL_DUREE_JOURNAUX=
ARRIMO_LEGAL_DUREE_REFERENCES=
ARRIMO_LEGAL_HEBERGEUR=
ARRIMO_LEGAL_ENTENTE=
